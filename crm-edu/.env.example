# ─────────────────────────────────────────────────────────────
#  CRM EDU - Environment Variables Configuration
#  Sao chép file này thành .env và điền các giá trị thực tế
# ─────────────────────────────────────────────────────────────

# Tên và Phiên bản ứng dụng
VITE_APP_NAME="CRM EDU"
VITE_APP_VERSION="1.0.0"

# Cổng phát triển của Vite
VITE_PORT=5173

# Cấu hình kết nối Frappe mặc định ban đầu (tùy chọn)
# Người dùng có thể cấu hình trực tiếp trên giao diện Cài đặt Kết nối
VITE_DEFAULT_FRAPPE_URL="http://localhost:8000"

# LƯU Ý BẢO MẬT:
# Không commit file .env chứa API Key và API Secret vào Git repository!
